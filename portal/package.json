{
  "name": "paas-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Hyunbbai portal API and dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "predev": "npm run build",
    "dev:client": "vite build --watch"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "dockerode": "^4.0.9",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "ws": "^8.19.0",
    "yaml": "^2.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "@vitejs/plugin-react": "^5.0.4"
  }
}
