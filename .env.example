# 루트 도메인. 포털은 portal.{PAAS_DOMAIN}, 유저 앱은 {user}-{app}.apps.{PAAS_DOMAIN} 으로 서빙된다.
# DNS: 루트 A, portal A/CNAME, *.apps 와일드카드 3건을 등록해야 한다.
PAAS_DOMAIN=my.domain.com

# Let's Encrypt (ACME) — Traefik이 인증서 발급 시 사용할 이메일
# 인증서 체계: 자체 존(portal/루트/*.apps 와일드카드)은 DNS-01로 발급·공유하고,
# 커스텀 도메인은 HTTP-01로 발급한다 (inbound 80이 외부에서 접근 가능해야 함).
ACME_EMAIL=your@email.com
# 실행 중인 Traefik이 없을 때만 사용하는 새 프록시의 기본 이미지.
TRAEFIK_IMAGE=traefik:latest
# ZeroSSL 또는 EAB 인증이 필요한 사설 ACME CA에서만 설정한다.
ACME_EAB_KID=
ACME_EAB_HMAC=
# Cloudflare API Token — DNS-01 challenge용 (Edit zone DNS 권한 필요)
CF_DNS_API_TOKEN=your-cloudflare-api-token

# Portal
PORTAL_PORT=3000
# docker-compose.admin.yml을 사용할 때만 여는 서버 루프백 포트
PORTAL_ADMIN_PORT=3000
SESSION_COOKIE_NAME=portal_session
SESSION_TTL_HOURS=168
PORTAL_COOKIE_SECURE=false
BCRYPT_ROUNDS=10
PORTAL_TRUST_PROXY=true

# 앱 생성·배포 후 할당 도메인의 루트 경로에서 HTTP 200을 기다리는 시간과 검사 주기
APP_HEALTH_TIMEOUT_SECS=120
APP_HEALTH_INTERVAL_MS=2000
APP_HEALTH_REQUEST_TIMEOUT_MS=5000

# 앱 전체의 CPU·메모리 예산과 서비스별 PID 상한
DEFAULT_MEM_LIMIT=256m
DEFAULT_CPU_LIMIT=0.5
DEFAULT_PIDS_LIMIT=128
MAX_SERVICES_PER_APP=8
DEFAULT_RESTART_POLICY=unless-stopped

# ── GitHub App (private repo 배포) ──
# GitHub App 설정의 Callback URL을 "https://portal.<PAAS_DOMAIN>/api/github/callback" 으로 맞춘다. (포털 코드가 별도로 읽는 env는 아니며, GitHub App 측 설정값이다)
# 그리고 App 설정에서 "Request user authorization (OAuth) during installation"을 켠다.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=my-paas-app
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=change-me-github-app-client-secret
# 개인키: 아래 둘 중 하나만 사용 (파일 경로 권장: env 평문 노출 면적 축소)
# 컨테이너 내 경로 기준. 리포 루트가 /paas에 마운트되므로 portal-data/ 에 .pem을 두면 된다(.gitignore됨).
GITHUB_APP_PRIVATE_KEY_PATH=/paas/portal-data/github-app-private-key.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# OAuth state 서명용 비밀 (임의 긴 랜덤 문자열). 예: openssl rand -base64 32
GITHUB_STATE_SECRET=change-me-to-a-long-random-secret

# App limits
MAX_APPS_PER_USER=5
MAX_TOTAL_APPS=20
